{
  "name": "structmap-solo",
  "displayName": "StructMap-Solo",
  "description": "Local-First, Privacy-First structure visualizer for Markdown, JSON, and YAML without AI.",
  "version": "0.0.1",
  "publisher": "structmap-solo",
  "repository": {
    "type": "git",
    "url": "https://github.com/masanori-satake/StructMap-Solo.git"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Visualization",
    "Other"
  ],
  "activationEvents": [
    "onView:structmap-solo.view"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "structmap-solo.copyTree",
        "title": "Copy Tree",
        "category": "StructMap",
        "icon": "$(copy)"
      },
      {
        "command": "structmap-solo.toggleTypes",
        "title": "Toggle Types",
        "category": "StructMap",
        "icon": "$(symbol-parameter)"
      },
      {
        "command": "structmap-solo.toggleTreeStyle",
        "title": "Toggle Tree Style",
        "category": "StructMap",
        "icon": "$(list-tree)"
      },
      {
        "command": "structmap-solo.toggleRoot",
        "title": "Toggle Root",
        "category": "StructMap",
        "icon": "$(root-folder)"
      },
      {
        "command": "structmap-solo.refresh",
        "title": "Refresh",
        "category": "StructMap",
        "icon": "$(refresh)"
      }
    ],
    "views": {
      "explorer": [
        {
          "id": "structmap-solo.view",
          "name": "StructMap"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "structmap-solo.copyTree",
          "when": "view == structmap-solo.view",
          "group": "navigation@1"
        },
        {
          "command": "structmap-solo.toggleTypes",
          "when": "view == structmap-solo.view",
          "group": "navigation@2"
        },
        {
          "command": "structmap-solo.toggleTreeStyle",
          "when": "view == structmap-solo.view",
          "group": "navigation@3"
        },
        {
          "command": "structmap-solo.toggleRoot",
          "when": "view == structmap-solo.view",
          "group": "navigation@4"
        },
        {
          "command": "structmap-solo.refresh",
          "when": "view == structmap-solo.view",
          "group": "navigation@5"
        }
      ]
    },
    "configuration": {
      "type": "object",
      "title": "StructMap",
      "properties": {
        "structMap.autoRefresh": {
          "type": "boolean",
          "default": true,
          "description": "Enable automatic refresh of StructMap view."
        },
        "structMap.debounceMs": {
          "type": "number",
          "default": 300,
          "description": "Debounce delay for StructMap view updates in milliseconds."
        },
        "structMap.maxFileSizeMB": {
          "type": "number",
          "default": 5,
          "description": "Maximum file size in megabytes to process."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src --ext ts",
    "test": "vscode-test",
    "package": "vsce package"
  },
  "dependencies": {
    "js-yaml": "^4.1.0"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/mocha": "^10.0.6",
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "@typescript-eslint/eslint-plugin": "^7.1.0",
    "@typescript-eslint/parser": "^7.1.0",
    "@vscode/test-cli": "^0.0.8",
    "@vscode/test-electron": "^2.3.9",
    "@vscode/vsce": "^2.24.0",
    "eslint": "^8.57.0",
    "glob": "^10.5.0",
    "mocha": "^10.3.0",
    "typescript": "^5.3.3"
  }
}
