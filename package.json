{
  "name": "structmap-solo",
  "displayName": "StructMap-Solo",
  "description": "%extension.description%",
  "version": "1.5.1",
  "icon": "assets/icon.png",
  "publisher": "masanori-satake",
  "repository": {
    "type": "git",
    "url": "https://github.com/masanori-satake/StructMap-Solo.git"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Visualization",
    "Other"
  ],
  "activationEvents": [
    "onView:structmap-solo.view",
    "onLanguage:markdown",
    "onLanguage:json",
    "onLanguage:yaml",
    "onLanguage:xml"
  ],
  "main": "./out/extension.js",
  "l10n": "./l10n",
  "contributes": {
    "languages": [
      {
        "id": "xml",
        "extensions": [
          ".xml"
        ]
      }
    ],
    "commands": [
      {
        "command": "structmap-solo.copyTree",
        "title": "%command.copyTree%",
        "category": "StructMap",
        "icon": "$(copy)"
      },
      {
        "command": "structmap-solo.copyVisibleTree",
        "title": "%command.copyVisibleTree%",
        "category": "StructMap",
        "icon": "$(copy)"
      },
      {
        "command": "structmap-solo.expandAll",
        "title": "%command.expandAll%",
        "category": "StructMap",
        "icon": "$(expand-all)"
      },
      {
        "command": "structmap-solo.collapseAll",
        "title": "%command.collapseAll%",
        "category": "StructMap",
        "icon": "$(collapse-all)"
      },
      {
        "command": "structmap-solo.toggleTypes",
        "title": "%command.toggleTypes%",
        "category": "StructMap",
        "icon": "$(symbol-parameter)",
        "enablement": "structmap-solo.typesSupported"
      },
      {
        "command": "structmap-solo.toggleTreeStyle",
        "title": "%command.toggleTreeStyle%",
        "category": "StructMap",
        "icon": "$(list-tree)"
      },
      {
        "command": "structmap-solo.toggleRoot",
        "title": "%command.toggleRoot%",
        "category": "StructMap",
        "icon": "$(root-folder)"
      },
      {
        "command": "structmap-solo.refresh",
        "title": "%command.refresh%",
        "category": "StructMap",
        "icon": "$(refresh)"
      }
    ],
    "views": {
      "explorer": [
        {
          "id": "structmap-solo.view",
          "name": "%view.name%"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "structmap-solo.copyTree",
          "when": "view == structmap-solo.view",
          "group": "navigation@1"
        },
        {
          "command": "structmap-solo.copyVisibleTree",
          "when": "view == structmap-solo.view",
          "group": "navigation@1.5"
        },
        {
          "command": "structmap-solo.expandAll",
          "when": "view == structmap-solo.view",
          "group": "navigation@2"
        },
        {
          "command": "structmap-solo.collapseAll",
          "when": "view == structmap-solo.view",
          "group": "navigation@3"
        },
        {
          "command": "structmap-solo.toggleTypes",
          "when": "view == structmap-solo.view",
          "group": "navigation@4"
        },
        {
          "command": "structmap-solo.toggleTreeStyle",
          "when": "view == structmap-solo.view",
          "group": "navigation@5"
        },
        {
          "command": "structmap-solo.toggleRoot",
          "when": "view == structmap-solo.view",
          "group": "navigation@6"
        },
        {
          "command": "structmap-solo.refresh",
          "when": "view == structmap-solo.view",
          "group": "navigation@7"
        }
      ]
    },
    "configuration": {
      "type": "object",
      "title": "%config.title%",
      "properties": {
        "structMap.autoRefresh": {
          "type": "boolean",
          "default": true,
          "description": "%config.autoRefresh%"
        },
        "structMap.debounceMs": {
          "type": "number",
          "default": 500,
          "description": "%config.debounceMs%"
        },
        "structMap.maxFileSizeMB": {
          "type": "number",
          "default": 5,
          "description": "%config.maxFileSizeMB%"
        },
        "structMap.maxArrayItems": {
          "type": "integer",
          "default": 50,
          "minimum": 1,
          "description": "%config.maxArrayItems%"
        },
        "structMap.customMappings": {
          "type": "object",
          "default": {},
          "description": "%config.customMappings%",
          "additionalProperties": {
            "type": "string"
          }
        },
        "structMapSolo.customMappings": {
          "type": "object",
          "default": {},
          "description": "%config.customMappings%",
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src --ext ts",
    "test": "vscode-test",
    "package": "vsce package",
    "convert-icon": "node scripts/convert-icon.js"
  },
  "dependencies": {
    "js-yaml": "^4.1.0"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/mocha": "^10.0.6",
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "@typescript-eslint/eslint-plugin": "^7.1.0",
    "@typescript-eslint/parser": "^7.1.0",
    "@vscode/test-cli": "^0.0.8",
    "@vscode/test-electron": "^2.3.9",
    "@vscode/vsce": "^2.24.0",
    "eslint": "^8.57.0",
    "glob": "^10.5.0",
    "mocha": "^10.3.0",
    "playwright": "^1.64.1",
    "typescript": "^5.3.3"
  }
}
